<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ── Top bar ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status dot -->
        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_green"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BUDDY"
            android:textSize="15sp"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:letterSpacing="0.45"/>

        <ImageButton
            android:id="@+id/btnCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/text2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Camera"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/text2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"/>
    </LinearLayout>

    <View
        android:id="@+id/divTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent_dim"
        android:alpha="0.5"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <!-- ── Waveform ──────────────────────────────────────────────────── -->
    <com.buddy.app.ui.WaveformView
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/divTop"/>

    <!-- ── Status text ───────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hold mic to speak"
        android:textSize="12sp"
        android:textColor="@color/text3"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/waveform"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Camera preview (hidden) ───────────────────────────────────── -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"/>

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="📷  Ask Buddy"
        android:textColor="@color/bg"
        android:backgroundTint="@color/accent"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cameraPreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- ── Messages ──────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/btnCapture"
        app:layout_constraintBottom_toTopOf="@id/divBottom"/>

    <View
        android:id="@+id/divBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent_dim"
        android:alpha="0.5"
        app:layout_constraintBottom_toTopOf="@id/inputBar"/>

    <!-- ── Input bar ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@color/bg2"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Hold-to-talk mic button -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/bg_mic"
            android:tint="@color/accent"
            android:contentDescription="Hold to speak"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type or hold mic…"
            android:hintTextColor="@color/text3"
            android:textColor="@color/text1"
            android:textSize="15sp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"/>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/bg_send"
            android:tint="@color/bg"
            android:contentDescription="Send"
            android:enabled="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
