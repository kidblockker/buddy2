<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/accent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="SETTINGS"
                android:textSize="15sp"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:letterSpacing="0.4"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="API KEY" android:textSize="11sp" android:textColor="@color/accent"
            android:letterSpacing="0.4" android:layout_marginBottom="6dp"/>

        <EditText android:id="@+id/etApiKey"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="sk-ant-..." android:hintTextColor="@color/text3"
            android:textColor="@color/text1" android:background="@drawable/bg_input"
            android:padding="14dp" android:inputType="textPassword"
            android:layout_marginBottom="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Get one free at console.anthropic.com"
            android:textSize="11sp" android:textColor="@color/text3"
            android:layout_marginBottom="28dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ABOUT YOU" android:textSize="11sp" android:textColor="@color/accent"
            android:letterSpacing="0.4" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Your name" android:hintTextColor="@color/text3"
            android:textColor="@color/text1" android:background="@drawable/bg_input"
            android:padding="14dp" android:inputType="textPersonName|textCapWords"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etAge"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Your age" android:hintTextColor="@color/text3"
            android:textColor="@color/text1" android:background="@drawable/bg_input"
            android:padding="14dp" android:inputType="number"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etOccupation"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="What you do" android:hintTextColor="@color/text3"
            android:textColor="@color/text1" android:background="@drawable/bg_input"
            android:padding="14dp" android:inputType="textCapWords"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etCity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Your city" android:hintTextColor="@color/text3"
            android:textColor="@color/text1" android:background="@drawable/bg_input"
            android:padding="14dp" android:inputType="textCapWords"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etInterests"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Interests (tech, finance, fitness…)"
            android:hintTextColor="@color/text3" android:textColor="@color/text1"
            android:background="@drawable/bg_input" android:padding="14dp"
            android:inputType="textCapSentences" android:layout_marginBottom="28dp"/>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="SAVE" android:textColor="@color/bg"
            android:backgroundTint="@color/accent"
            android:letterSpacing="0.2" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="All data stays on your device. Only your messages go to Anthropic's API."
            android:textSize="11sp" android:textColor="@color/text3"
            android:gravity="center" android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
